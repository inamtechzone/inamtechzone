{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/collections/:category/products/:handle", "destination": "/product.html" },
    { "source": "/collections/:category", "destination": "/shop.html" },
    { "source": "/p/:code", "destination": "/shortlink.html" }
  ]
}
